# Application Configuration
NODE_ENV=production
PORT=3000

# Public URL (should be your domain in production)
PUBLIC_URL=https://your-domain.com

# Docker Image (optional - use specific version for production)
# DOCKER_IMAGE=elidickinson/happy-server-light:latest

# Optional: Hand-crafted master secret for token generation
# If not provided, the app will generate one and persist it
# HANDY_MASTER_SECRET=your-super-secret-key-here

# Optional: Custom data directory (defaults to /app/.happy)
# HAPPY_SERVER_LIGHT_DATA_DIR=/app/data

# Optional: Custom files directory (defaults to /app/.happy/files)
# HAPPY_SERVER_LIGHT_FILES_DIR=/app/files
