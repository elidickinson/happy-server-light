#
# happy-server-light
#
# Goal: run Happy locally with a single SQLite file (no Postgres/Redis/Minio).
#

# HTTP port
PORT=3005

# Prisma SQLite database (single file)
# If you don't set this, happy-server-light will default to:
#   file:$HOME/.happy/server-light/happy-server-light.sqlite
# But Prisma CLI tools don't expand $HOME inside .env files, so prefer an absolute path if you use this.
DATABASE_URL="file:/absolute/path/to/.happy/server-light/happy-server-light.sqlite"

# Base URL used when generating public file URLs (avatars/images/etc)
PUBLIC_URL="http://localhost:3005"

# Optional: override where happy-server-light stores its local data.
# If omitted, defaults to "~/.happy/server-light".
HAPPY_SERVER_LIGHT_DATA_DIR="/absolute/path/to/.happy/server-light"
HAPPY_SERVER_LIGHT_FILES_DIR="/absolute/path/to/.happy/server-light/files"

# Optional: if not provided, happy-server-light will generate one on first run
# and persist it to "$HAPPY_SERVER_LIGHT_DATA_DIR/handy-master-secret.txt" (0600).
# HANDY_MASTER_SECRET="..."

